{
  "name": "swg-source-js",
  "version": "0.1.0",
  "private": true,
  "description": "Star Wars Galaxies Server - TypeScript Implementation",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "docker:build": "docker-compose -f docker/docker-compose.yml build",
    "docker:dev": "docker-compose -f docker/docker-compose.dev.yml up --build",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "docker:logs": "docker-compose -f docker/docker-compose.yml logs -f",
    "docker:clean": "docker-compose -f docker/docker-compose.yml down -v --rmi local"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
