{
  "name": "@swg/integration-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Integration tests for SWG TypeScript server",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
