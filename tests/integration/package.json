    "load-test": "tsx load/load-test.ts"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^10.7.0",
    "@types/node": "^22.10.0",
    "testcontainers": "^10.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@swg/config": "workspace:*",
    "@swg/database": "workspace:*",
    "@swg/protocol": "workspace:*",
    "@swg/redis": "workspace:*",
    "ioredis": "^5.3.2",
    "mysql2": "^3.11.0"
  }
}
