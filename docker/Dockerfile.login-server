# Login Server Dockerfile
# Handles player authentication and session management

# Build stage - compile TypeScript
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Copy package files for dependency installation
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/login-server/package.json ./apps/login-server/
COPY packages/config/package.json ./packages/config/
COPY packages/database/package.json ./packages/database/
COPY packages/protocol/package.json ./packages/protocol/
COPY packages/redis/package.json ./packages/redis/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/objects/package.json ./packages/objects/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY apps/login-server ./apps/login-server
COPY packages/config ./packages/config
COPY packages/database ./packages/database
COPY packages/protocol ./packages/protocol
COPY packages/redis ./packages/redis
COPY packages/shared-types ./packages/shared-types
COPY packages/objects ./packages/objects
COPY tsconfig.json ./

# Build the application (turbo handles dependency graph - builds @swg/protocol etc. first)
RUN pnpm turbo run build --filter=@swg/login-server

# Production stage
FROM node:22-alpine AS production

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Install runtime dependencies
RUN apk add --no-cache \
    dumb-init \
    curl \
    bash \
    netcat-openbsd \
    && rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S swg && \
    adduser -u 1001 -S swg -G swg

WORKDIR /app

# Copy package files for production dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/login-server/package.json ./apps/login-server/
COPY packages/config/package.json ./packages/config/
COPY packages/database/package.json ./packages/database/
COPY packages/protocol/package.json ./packages/protocol/
COPY packages/redis/package.json ./packages/redis/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/objects/package.json ./packages/objects/

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod

# Copy built application from builder stage
COPY --from=builder /app/apps/login-server/dist ./apps/login-server/dist
COPY --from=builder /app/packages/config/dist ./packages/config/dist
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/protocol/dist ./packages/protocol/dist
COPY --from=builder /app/packages/redis/dist ./packages/redis/dist
COPY --from=builder /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=builder /app/packages/objects/dist ./packages/objects/dist

# Copy scripts
COPY --chmod=755 docker/scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=755 docker/scripts/healthcheck.sh /usr/local/bin/healthcheck.sh

# Create directories
RUN mkdir -p /app/logs /app/data && \
    chown -R swg:swg /app

# Environment
ENV NODE_ENV=production
ENV SERVER_TYPE=login-server
ENV LOGIN_SERVER_PORT=44453

# Expose UDP port for SWG client connections
EXPOSE 44453/udp

# Health check - verify server is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh login-server 44453

# Labels
LABEL org.opencontainers.image.title="SWG Login Server"
LABEL org.opencontainers.image.description="Star Wars Galaxies Login Server"

USER swg

ENTRYPOINT ["/usr/bin/dumb-init", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["node", "apps/login-server/dist/index.js"]
