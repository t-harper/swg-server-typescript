# =============================================================================
# Star Wars Galaxies Server - Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your deployment
# IMPORTANT: Never commit .env files containing real credentials

# =============================================================================
# Environment
# =============================================================================

NODE_ENV=production

# =============================================================================
# MySQL Database Configuration
# =============================================================================

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=swgemu
MYSQL_USER=swgemu
MYSQL_PASSWORD=change_me_swgemu_password
MYSQL_PORT=3306

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

# =============================================================================
# Server Configuration
# =============================================================================

# Display name for the server
SERVER_NAME=My SWG Server

# Logging level: error, warn, info, debug, trace
LOG_LEVEL=info

# =============================================================================
# Server Ports
# =============================================================================

# Login server port (UDP) - players connect here first
LOGIN_SERVER_PORT=44453

# Connection server port (UDP) - handles server selection
CONNECTION_SERVER_PORT=44455

# Chat server port (TCP) - internal communication
CHAT_SERVER_PORT=44462

# Game server base port (UDP) - game world simulation
# Additional instances will use sequential ports (44461, 44462, etc.)
GAME_SERVER_PORT=44460

# =============================================================================
# Scaling Configuration
# =============================================================================

# Number of game server replicas (for production)
GAME_SERVER_REPLICAS=2

# =============================================================================
# Feature Flags
# =============================================================================

# Enable debug endpoints (disable in production!)
ENABLE_DEBUG_ENDPOINTS=false

# Enable metrics collection
ENABLE_METRICS=true

# Enable player vs player combat
ENABLE_PVP=true

# Enable Galactic Civil War features
ENABLE_GCW=true

# Enable player housing
ENABLE_PLAYER_HOUSING=true

# Enable space expansion features
ENABLE_SPACE=true

# =============================================================================
# Rate Limiting
# =============================================================================

# Maximum login attempts per IP per minute
LOGIN_RATE_LIMIT=10

# Maximum connections per IP
MAX_CONNECTIONS_PER_IP=5

# =============================================================================
# Game Settings
# =============================================================================

# Maximum players per game server instance
MAX_PLAYERS_PER_INSTANCE=3000

# Server tick rate in milliseconds
SERVER_TICK_RATE=100

# Auto-save interval in seconds
AUTO_SAVE_INTERVAL=300

# AFK timeout in minutes (0 to disable)
AFK_TIMEOUT=30

# =============================================================================
# External Services (Optional)
# =============================================================================

# Discord webhook for server notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/yyy

# StatsD host for metrics
# STATSD_HOST=statsd
# STATSD_PORT=8125
